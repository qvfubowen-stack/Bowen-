# =====================================================================
# 博文外贸独立站 — .gitignore
# 原则：原始资料只读入库；派生产物按需入库；体积大且可再生的不进库。
# =====================================================================

# ---- 依赖与构建产物（可再生，不入库）----
node_modules/
dist/
build/
.cache/
.next/
out/
*.tsbuildinfo

# ---- 运行日志与临时文件 ----
*.log
npm-debug.log*
logs/
tmp/
temp/
.tmp/
~$*

# ---- 编辑器 / 操作系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ---- 密钥，绝不入库 ----
.env
.env.*
!.env.example
*.pem
*.key

# ---- Excel 打开时的锁文件 ----
*.xlsx.lock
.~lock.*

# =====================================================================
# 说明（不要删除以下“保留”条目）：
#   data/raw/**            原始 Excel / PDF —— 只读原始资料，必须入库以便追溯
#   data/derived/**        ETL 派生产物 —— 入库（体积小、需要 diff 审阅）
#   docs/**                文档 —— 入库
# =====================================================================
