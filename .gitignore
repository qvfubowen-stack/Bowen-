# =====================================================================
# 博文外贸独立站 — .gitignore
# 原则：原始资料只读入库；派生产物按需入库；体积大且可再生的不进库。
# =====================================================================

# ---- 依赖与构建产物（可再生，不入库）----
node_modules/
dist/
build/
.cache/
.next/
out/
*.tsbuildinfo

# ---- 只接受 pnpm-lock.yaml 一份锁文件 ----
# 本项目唯一推荐的包管理器是 pnpm（版本见 website/package.json 的 packageManager）。
# 用 npm / yarn 安装会生成第二份锁文件，导致依赖解析不一致，因此不入库。
package-lock.json
yarn.lock

# ---- 包管理器本地缓存（本机沙箱要求缓存必须落在工作区内，绝不入库）----
.pnpm-store/
.pnpm-cache/
.pnpm-state/
_tooltest/

# ---- 探针/临时输出（可重新生成）----
data/derived/_sheets-v2/

# ---- 交付 ZIP（体积大、可由 node tools/make-delivery-zips.mjs 重新生成）----
# 交付物本身仍然保留在工作区，只是不进 Git 历史。
delivery/zips/

# ---- 提取出的产品图片二进制（66.5 MB，可由原始 Excel 一条命令重新生成）----
#   node tools/extract-product-images.mjs
# 映射文件 product-image-map.json 仍然入库（体积小、需要 diff 审阅）。
# 图片本身仍然保留在工作区，并且会打进交付 ZIP。
data/processed/product-images/

# ---- Phase 3.5：从旧站 www.qfbowen.com 下载的媒体素材二进制（体积大，可重新下载）----
#   node tools/legacy/download-legacy-assets.mjs
# 说明：assets.json / downloads.json / product-image-matching.json 等清单文件仍然入库
#       （体积小、需要 diff 审阅）；抓取的 HTML 也入库（体积小，是审计证据）。
data/legacy-site/images/
data/legacy-site/documents/
# 下载器的临时"就地迁移缓存"（分类规则调整时用于避免重复请求旧站，运行结束会自删）
data/legacy-site/.relocate-cache/

# ---- 运行日志与临时文件 ----
*.log
npm-debug.log*
logs/
tmp/
temp/
.tmp/
~$*

# ---- Phase 5：RFQ 本地运行数据，绝不入库 ----
# .rfq-data/  无数据库凭据时 json 驱动写入的询价记录（含客户联系方式，属于个人数据）
# .rfq-mock/  自动化测试用的 mock 邮件 outbox（含测试邮件正文）
# 两者都可能包含真实客户信息，只应存在于服务器本地磁盘。
.rfq-data/
.rfq-mock/
rfq-outbox.jsonl

# ---- 编辑器 / 操作系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ---- 密钥，绝不入库 ----
.env
.env.*
!.env.example
*.pem
*.key

# ---- Excel 打开时的锁文件 ----
*.xlsx.lock
.~lock.*

# =====================================================================
# 说明（不要删除以下“保留”条目）：
#   data/raw/**            原始 Excel / PDF —— 只读原始资料，必须入库以便追溯
#   data/derived/**        ETL 派生产物 —— 入库（体积小、需要 diff 审阅）
#   docs/**                文档 —— 入库
# =====================================================================
