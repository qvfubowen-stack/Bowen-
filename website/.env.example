# ===========================================================================
# 博文外贸独立站 — 环境变量模板（Phase 5.1）
# ===========================================================================
# 用法：
#   1. 复制成 .env.local（本地/预览）或写入部署平台的环境变量面板（正式环境）
#   2. 本文件**只放变量名与安全示例**，绝不能填真实密钥
#
# ⚠️ 绝对不要把真实值写进这个文件、Git、文档、日志或截图：
#      Resend API Key、Supabase Service Role Key、126 邮箱授权码、
#      Turnstile Secret、RFQ_IP_HASH_SECRET、任何 token。
#    凡是没有 NEXT_PUBLIC_ 前缀的变量都只在服务端读取，
#    但"只在服务端读取"不等于"可以写进仓库"。
#
# 没有值的变量请留空，不要编造：
#   没有正式域名就不要写 RFQ_FROM_EMAIL，
#   没有 Supabase 项目就不要写 SUPABASE_URL。
# ===========================================================================

# ---------------------------------------------------------------------------
# 0. 托管生产环境的硬保护（Phase 5.1）
# ---------------------------------------------------------------------------
# VERCEL_ENV 由 Vercel 平台自动注入（production / preview / development），
# **不需要也不应该手工设置**。这里列出只是因为生产就绪校验依赖它。
#
# 当 VERCEL_ENV=production 时，构建与启动会强制要求下面 11 项全部就位：
#   1  NEXT_PUBLIC_SITE_URL 是正式 https 地址
#   2  SUPABASE_URL
#   3  SUPABASE_SERVICE_ROLE_KEY
#   4  RFQ_STORE_DRIVER 解析结果为 supabase
#   5  RESEND_API_KEY
#   6  RFQ_FROM_EMAIL
#   7  RFQ_MAIL_DRIVER 解析结果为 resend
#   8  RFQ_IP_HASH_SECRET
#   9  NEXT_PUBLIC_TURNSTILE_SITE_KEY
#  10  TURNSTILE_SECRET_KEY
#  11  上面两个 Turnstile key 必须成对（不允许只配一个）
# 缺任何一项都会**直接构建失败**（只报变量名，不报变量值），
# 并且不允许静默回退成 json / memory / mock / unconfigured。
#
# 本地与 Preview 不受影响：仍可用 json + mock，仍默认 noindex。
# 另外：本地 `next build` 与 Vercel Preview 也都是 NODE_ENV=production，
#       所以刻意**不用** NODE_ENV 判断"真正上线"。
# VERCEL_ENV=

# ---------------------------------------------------------------------------
# 1. 站点地址与收录开关
# ---------------------------------------------------------------------------
# 正式站点地址（含协议，无尾斜杠）。
# 不配置时：不输出 canonical，sitemap 为空，且全站保持 noindex。
# 正式上线时填写业务方域名，例如：https://www.bowen-tech.cn
NEXT_PUBLIC_SITE_URL=

# 搜索引擎收录开关。默认 false。
# false → 全站 noindex, nofollow（meta + X-Robots-Tag 双重保护），robots.txt 全站 Disallow
# true  → 公开页面允许 index, follow；/rfq、/oe-search、/api、/blog 始终 noindex
# 只有正式环境 + 正式 https 域名 + 业务方明确同意时才设为 true。
SITE_INDEXING_ENABLED=false

# ---------------------------------------------------------------------------
# 2. RFQ 邮件发送（推荐 Resend，也可换成任何兼容实现）
# ---------------------------------------------------------------------------
# 销售收件邮箱（业务方已确认）。留空时使用内置默认值 qfbowen@126.com。
RFQ_RECIPIENT_EMAIL=

# 发件人地址，必须是邮件服务商已验证的发件域，例如：Bowen RFQ <rfq@bowen-tech.cn>
# 没有正式域名时留空：系统会明确报"发件人未配置"，不会假装发送成功。
RFQ_FROM_EMAIL=

# 邮件服务商 API Key（服务端专用，绝不加 NEXT_PUBLIC_ 前缀）
RESEND_API_KEY=

# 邮件驱动：留空 = 自动（有凭据用 resend，生产环境无凭据则明确失败；非生产用 mock）
# 可选值：mock | resend | unconfigured
RFQ_MAIL_DRIVER=

# ---------------------------------------------------------------------------
# 3. RFQ 询价记录存储（只存询价，不迁移产品数据）
# ---------------------------------------------------------------------------
# Supabase 项目地址，例如：https://<project-ref>.supabase.co
SUPABASE_URL=
# Supabase service role key（服务端专用；此密钥可绕过 RLS，泄露等于全表泄露）
SUPABASE_SERVICE_ROLE_KEY=

# 存储驱动：留空 = 自动（配置了上面两项就用 supabase，否则写本地 JSONL 文件）
# 可选值：memory | json | supabase
#   memory  仅用于自动化测试，进程重启即丢
#   json    无凭据时的持久化回退，写入 RFQ_JSON_STORE_PATH
RFQ_STORE_DRIVER=

# json 驱动的文件路径（留空 = <项目目录>/.rfq-data/rfq-inquiries.jsonl，已在 .gitignore 中）
RFQ_JSON_STORE_PATH=

# ---------------------------------------------------------------------------
# 4. 反垃圾与限流
# ---------------------------------------------------------------------------
# 限流用 IP 哈希密钥。生成方式（任选其一）：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 留空时进程内使用随机密钥（重启即失效，且多实例之间不共享）。
RFQ_IP_HASH_SECRET=

# 单连接在时间窗内允许的询价次数与时间窗（秒）
RFQ_RATE_LIMIT_MAX=5
RFQ_RATE_LIMIT_WINDOW_SECONDS=600

# 最短填写耗时（毫秒），低于该值视为机器人
RFQ_MIN_FILL_MS=3000

# 相同内容重复提交的去重窗口（秒）
RFQ_DUPLICATE_WINDOW_SECONDS=900

# 是否信任反向代理传来的客户端 IP 请求头（x-forwarded-for / x-real-ip）。
# 只有部署在会覆写该头的代理（nginx / Cloudflare / Vercel 等）后面才可设为 true，
# 否则客户端可以伪造该头绕过限流。留空 = false。
RFQ_TRUST_PROXY=

# ---------------------------------------------------------------------------
# 5. Cloudflare Turnstile（生产必填，本地/预览可留空）
# ---------------------------------------------------------------------------
# 配置 SECRET 后，RFQ 表单提交必须携带有效 token，否则拒绝。
# 不配置时表单不显示验证码，其余反垃圾手段（honeypot / 最短耗时 / 限流 / 去重）仍然生效。
#
# ⚠️ 两个 key 必须**成对**配置：
#      生产环境只配其中一个 → 构建直接失败；
#      本地/预览只配其中一个 → 只打印警告（方便调试）。
# ⚠️ 生产环境（VERCEL_ENV=production）两项都是必填。
TURNSTILE_SECRET_KEY=
# 站点密钥（会进入浏览器，必须用 NEXT_PUBLIC_ 前缀；同时决定 CSP 是否放行 Cloudflare）
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---------------------------------------------------------------------------
# 6. 自动化测试专用（**绝对不要**在生产环境设置）
# ---------------------------------------------------------------------------
# mock 邮件驱动的 outbox 文件路径（留空 = <项目目录>/.rfq-mock/outbox.jsonl）
RFQ_MOCK_OUTBOX_PATH=
# 设为 true 时 mock 邮件驱动故意失败，用于验证"邮件失败但询价已保存"
RFQ_MOCK_MAIL_FAIL=
# 设为 mock 时，服务端不访问真实 Cloudflare，只接受固定的测试 token。
# 在 VERCEL_ENV=production 下这个开关**强制失效**，且生产就绪校验会直接让构建失败。
RFQ_TURNSTILE_MODE=
# 前端 Turnstile 测试开关（构建期常量）。设为 1 时组件不加载任何外部脚本，
# 而是读取测试注入的 window.__BOWEN_TURNSTILE_MOCK__ 作为 token。
# 同样在生产就绪校验里被禁止。
NEXT_PUBLIC_TURNSTILE_MOCK=
