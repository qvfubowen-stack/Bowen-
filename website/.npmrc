# ===========================================================================
# 博文外贸独立站 — website/ 的依赖安装配置
# ===========================================================================
# 本项目唯一推荐的包管理器是 pnpm，版本锁定见 package.json 的 packageManager 字段。
#
# 为什么锁定 pnpm：
#   1. package.json 与 pnpm-lock.yaml 必须严格同步，才能用 --frozen-lockfile 做可复现安装；
#   2. pnpm-lock.yaml 的 lockfileVersion 是 9.0，需要 pnpm >= 9 才能读取；
#   3. pnpm 10 默认阻止依赖执行构建脚本，需要显式声明决策（见下）。
#
# 关于依赖的构建脚本（sharp）：
#   sharp 是 Next.js 的 optionalDependency，只在 Next 内置图片优化（next/image）时用到。
#   本站原型全部使用原生 <img>，**没有任何 next/image 用法**，因此 sharp 的
#   构建脚本不需要执行。这个决定显式写在 package.json 的 pnpm.ignoredBuiltDependencies 里，
#   避免每次安装都出现 "Ignored build scripts" 警告。
#   如果将来启用 next/image，请把 sharp 从 ignoredBuiltDependencies 移除并重新安装。
#
# ⚠️ 不要在这里写 package-lock=false / lockfile=false。
#    pnpm 会把它理解为「禁止读写 lockfile」，导致出现
#    "The current configuration prohibits to read or write a lockfile" 警告，
#    并使 --frozen-lockfile 失去意义。
#    要防止 npm 生成第二份锁文件，改用 .gitignore 忽略 package-lock.json。
#
# ===========================================================================

# 统一 peer 依赖处理方式，保证不同 pnpm 版本解析结果一致
auto-install-peers=true
strict-peer-dependencies=false

# 强制引擎版本（Node / pnpm），不满足直接报错而不是静默继续
engine-strict=true
